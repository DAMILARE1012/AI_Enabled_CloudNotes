# Base URL for the CloudNotes API. Ignored while VITE_USE_MOCKS=true.
VITE_API_BASE_URL=http://localhost:4000/api

# When true, requests are intercepted by MSW and served from in-memory mock data.
# Flip to false once a real backend is available at VITE_API_BASE_URL.
VITE_USE_MOCKS=true

# AWS Cognito Hosted UI (see "Authentication" in README.md for setup steps).
VITE_COGNITO_AUTHORITY=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
VITE_COGNITO_CLIENT_ID=<app-client-id>
VITE_COGNITO_DOMAIN=https://<your-domain>.auth.<region>.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/login
VITE_COGNITO_SCOPE=openid email profile
